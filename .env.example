# ─────────────────────────────────────────────────────────────────────────────
# Production RAG System — Environment Variables Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# In CI/CD, set these as GitHub Secrets / environment secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO
API_SECRET_KEY=change-me-to-a-random-256-bit-string   # used for API key auth

# ── LLM Provider (Groq is default — OpenAI-compatible) ───────────────────────
# Get your free key at: https://console.groq.com
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_API_KEY
LLM_MODEL=llama-3.1-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ── Fallback LLM (Google AI Studio — Gemini Flash) ───────────────────────────
# Get your free key at: https://aistudio.google.com
FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_LLM_API_KEY=AIza_REPLACE_WITH_YOUR_GEMINI_API_KEY
FALLBACK_LLM_MODEL=gemini-2.0-flash

# ── Embedding Model (local — no API key needed) ───────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu          # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32

# ── Reranker Model (local — no API key needed) ────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu           # cpu | cuda | mps
RERANKER_TOP_K=5              # number of chunks to pass to LLM after reranking

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_documents
# QDRANT_API_KEY=             # only needed for Qdrant Cloud

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600        # 1 hour

# ── Langfuse Observability ────────────────────────────────────────────────────
# Self-hosted Langfuse (runs via Docker Compose)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_AFTER_LANGFUSE_SETUP
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_AFTER_LANGFUSE_SETUP

# ── RAG Pipeline Tuning ───────────────────────────────────────────────────────
RETRIEVAL_TOP_K=50            # candidates from vector + BM25 before reranking
CHUNK_SIZE=512                # tokens per chunk
CHUNK_OVERLAP=64              # token overlap between consecutive chunks

# ── API Security & Rate Limiting ──────────────────────────────────────────────
API_AUTH_ENABLED=false        # set to true to enforce X-API-Key even in dev
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=60/minute
RATE_LIMIT_QUERY_LIMIT=30/minute
RATE_LIMIT_INGEST_LIMIT=10/minute
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1   # uncomment for distributed Redis rate limits
